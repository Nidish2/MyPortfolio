{
  "name": "nidish-portfolio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "next build",
    "dev": "next dev",
    "lint": "eslint .",
    "biome:check": "biome check .",
    "biome:fix": "biome check --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "start": "next start",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "check": "pnpm lint && pnpm biome:check && pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "framer-motion": "13.4.4",
    "lucide-react": "^0.454.0",
    "next": "16.3.7",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-intersection-observer": "11.0.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/node": "^22",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^5.0.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.7",
    "postcss": "^8.5",
    "tailwindcss": "^3.4.17",
    "typescript": "^5",
    "vitest": "^5.0.2"
  },
  "engines": {
    "node": ">=22.23.3 <25",
    "pnpm": ">=10.9.0"
  },
  "packageManager": "pnpm@10.9.0",
  "pnpm": {
    "overrides": {
      "browserslist": "^4.28.7",
      "brace-expansion": "^2.1.4",
      "picomatch": "^2.3.2",
      "yaml": "^2.8.3",
      "postcss-selector-parser": "^6.1.3",
      "glob": "^10.5.0",
      "minimatch": "^9.0.7"
    }
  }
}
